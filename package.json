{
    "name": "backend",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "dev": "tsnd -r tsconfig-paths/register --respawn --clear src/app.ts",
        "build": "rimraf ./dist && tsc",
        "start": "npm run build && node dist/app.js",
        "prisma:migrate:test": "dotenv -e .env.test -- npx prisma migrate deploy",
        "test": "npm run prisma:migrate:test && jest --runInBand",
        "test:watch": "npm run prisma:migrate:test && jest --watch --runInBand",
        "test:coverage": "npm run prisma:migrate:test && jest --coverage --runInBand",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,js,json}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.2",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^22.15.19",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.58.0",
        "@typescript-eslint/parser": "^8.58.0",
        "dotenv-cli": "^8.0.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jest": "^29.15.1",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-promise": "^7.2.1",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "lint-staged": "^16.4.0",
        "prettier": "^3.6.2",
        "prisma": "^6.8.2",
        "rimraf": "^6.0.1",
        "supertest": "^7.1.1",
        "ts-jest": "^29.3.4",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.58.0"
    },
    "dependencies": {
        "@prisma/client": "^6.8.2",
        "axios": "^1.10.0",
        "bcryptjs": "^3.0.2",
        "cors": "^2.8.5",
        "dotenv": "^16.5.0",
        "env-var": "^7.5.0",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.2"
    }
}
